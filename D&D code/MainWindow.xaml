<Window x:Class="VisualD_D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisualD_D" Height="500" Width="837">
    <Grid>

        <!-- MENÚ PRINCIPAL -->
        <StackPanel x:Name="MainMenu" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
            <Label Content="¡Crea tu propia historia aventurero!" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="Nueva Aventura" Width="200" Height="50" Click="NewAdventureClick"/>
            <Button Content="Continua donde lo dejaste" Width="200" Height="50" Margin="0,10,0,0" Click="ContinueAdventureClick"/>
            <Button Content="Abandonar" Width="200" Height="50" Margin="0,10,0,0" Click="ExitClick"/>
        </StackPanel>

        <!-- MENÚ DE SLOTS -->
        <StackPanel x:Name="SlotMenu" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Elige tu aventura" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>
            <Button x:Name="SlotButton1" Content="Slot 1" Width="200" Height="50" Click="SlotClick"/>
            <Button x:Name="SlotButton2" Content="Slot 2" Width="200" Height="50" Margin="0,10,0,0" Click="SlotClick"/>
            <Button x:Name="SlotButton3" Content="Slot 3" Width="200" Height="50" Margin="0,10,0,0" Click="SlotClick"/>
        </StackPanel>

        <!-- CUADRO DE DIÁLOGO CONFIRMACIÓN -->
        <StackPanel x:Name="ConfirmationDialog" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="DialogText" Text="¿Seguro que deseas sobreescribir?" Foreground="Black" TextAlignment="Center" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Sí" Width="60" Margin="10,0" Click="YesClick"/>
                <Button Content="No" Width="60" Margin="10,0" Click="NoClick"/>
            </StackPanel>
        </StackPanel>

        <!-- PANEL DE CREAR AVENTURA -->
        <StackPanel x:Name="CrearAventuraPanel" Visibility="Collapsed">
            <StackPanel>
                <Label Content="Nombre de la aventura *"/>
                <TextBox x:Name="NombreAventuraBox" Width="780" Height="30"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel Width="390">
                    <Label Content="Nombre del héroe *"/>
                    <TextBox x:Name="NombreHeroeBox" Width="380" Height="30"/>
                </StackPanel>
                <StackPanel Width="390" Margin="10,0,0,0">
                    <Label Content="Título del héroe"/>
                    <TextBox x:Name="TituloHeroeBox" Width="380" Height="30"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <Label Content="Raza *"/>
                <ComboBox x:Name="RazaCombo" Width="100" Height="30">
                    <ComboBoxItem Content="Humano"/>
                    <ComboBoxItem Content="Elfo"/>
                    <ComboBoxItem Content="Orco"/>
                    <ComboBoxItem Content="Enano"/>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <Label Content="Clase *"/>
                <ComboBox x:Name="ClaseCombo" Width="100" Height="30">
                    <ComboBoxItem Content="Guerrero"/>
                    <ComboBoxItem Content="Mago"/>
                    <ComboBoxItem Content="Sanador"/>
                    <ComboBoxItem Content="Ladrón"/>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <Label Content="Rol o trasfondo del héroe"/>
                <TextBox x:Name="LoreBox" Width="300" Height="30"/>
            </StackPanel>

            <TextBlock x:Name="PuntosRestantesTextBlock" Text="Puntos restantes: 15" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnInteligencia" Content="Inteligencia: 1" Width="120" Height="30" Click="IncrementarStat"/>
                <Button x:Name="BtnVida" Content="Vida: 1" Width="120" Height="30" Margin="10,0" Click="IncrementarStat"/>
                <Button x:Name="BtnConstitucion" Content="Constitución: 1" Width="120" Height="30" Margin="10,0" Click="IncrementarStat"/>
                <Button x:Name="BtnFuerza" Content="Fuerza: 1" Width="120" Height="30" Margin="10,0" Click="IncrementarStat"/>
                <Button x:Name="BtnVelocidad" Content="Velocidad: 1" Width="120" Height="30" Margin="10,0" Click="IncrementarStat"/>
            </StackPanel>

            <Button Content="Crear aventura" Width="200" Height="50" Click="ConfirmarCrearAventura" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- LABEL DE AVENTURA -->
        <Label x:Name="AdventureLabel" Content="" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" FontSize="14"/>

